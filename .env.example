# Copy to .env and add your Google AI Studio API key.
GOOGLE_API_KEY=
ENABLE_GEMINI=true
CHAT_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001

# Set a strong password to unlock the Streamlit Admin tab.
ADMIN_PASSWORD=

WEBSITE_URL=https://www.invertisuniversity.ac.in/
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=20
MAX_PAGES=120
CHUNK_SIZE=1000
CHUNK_OVERLAP=160
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.22
MEMORY_TURNS=5
